{
  "lifecycle": {
    "rule": [
      {
        "action": { "type": "Delete" },
        "condition": { "age": 14, "matchesPrefix": ["rolling/"] }
      },
      {
        "action": { "type": "Delete" },
        "condition": { "age": 56, "matchesPrefix": ["weekly/"] }
      },
      {
        "action": { "type": "Delete" },
        "condition": { "age": 365, "matchesPrefix": ["monthly/"] }
      }
    ]
  }
}
